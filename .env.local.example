# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# Used to build absolute URLs in Stripe checkout success/cancel links.
# Local dev: http://localhost:3000 — Production: https://myblackcloud.io
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — fixed unlock price in cents. Defaults to 900 ($9) if unset.
NEXT_PUBLIC_GAME_PRICE_CENTS=900

# Optional — Upstash Redis for rate limiting. Rate limiting fails open
# (disabled, not blocking) if these are unset, so the app works without them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
